{
  "name": "utkarsh-singh",
  "private": true,
  "version": "1.0.0",
  "description": "Personal site. Static HTML/CSS/JS with one compiled React island.",
  "scripts": {
    "build:js": "esbuild src/island.tsx --bundle --jsx=automatic --minify --format=iife --target=es2019 --outfile=assets/techtext.js --define:process.env.NODE_ENV='\"production\"'",
    "build:css": "tailwindcss -i src/tailwind.css -o assets/tailwind.css --minify",
    "build": "npm run build:css && npm run build:js",
    "watch": "esbuild src/island.tsx --bundle --jsx=automatic --format=iife --target=es2019 --outfile=assets/techtext.js --define:process.env.NODE_ENV='\"development\"' --watch"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.2"
  }
}